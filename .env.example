# Arif Car Sell — Environment Configuration

# ─── Authentication ───────────────────────────────────────────────
# Critical: Must be at least 32 characters in production
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-secret-for-refresh-tokens"

# ─── Database (MongoDB) ────────────────────────────────────────────
MONGODB_URI="mongodb://localhost:27017/arif_car_sell"

# ─── Cloudinary (Optional, fallbacks to internal MongoDB media store)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── SMTP (Email Notifications) ────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@arifcarsell.et"

# ─── App Hosting & CORS ─────────────────────────────────────────────
PORT="3000"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app"

# ─── Runtime Flags ──────────────────────────────────────────────────
NODE_ENV="development"
SEED_DB="false"
