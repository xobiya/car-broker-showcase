{
  "expo": {
    "name": "Arif Car Sell",
    "slug": "arif-car-sell",
    "scheme": "arifcarsell",
    "version": "1.0.0",
    "icon": "./assets/logo.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-font", "expo-image-picker", "expo-document-picker"],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arifcarsell.mobile",
      "icon": "./assets/logo.png"
    },
    "android": {
      "package": "com.arifcarsell.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "arifcarsell.et", "pathPrefix": "/vehicles" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
